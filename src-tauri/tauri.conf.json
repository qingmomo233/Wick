{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wick",
  "version": "0.2.0",
  "identifier": "com.wick.battery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wick",
        "width": 432,
        "height": 700,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "无线设备电量监控",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
